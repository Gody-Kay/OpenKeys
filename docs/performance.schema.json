{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openkeys.local/schema/performance.schema.json",
  "title": "OpenKeys Performance",
  "description": "One saved setup: up to 16 Parts, 8 Scenes, Master Knob map, effects, arpeggio. Owned by lane C, agreed with lane A. Changing this file needs a question first (SESSION_RULES section 3). Parameter IDs look like part.1.volume, part.3.sends.reverb, master.tuneHz.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "parts", "scenes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 64 },
    "category": { "type": "string", "maxLength": 32 },
    "tempo": { "type": "number", "minimum": 20, "maximum": 300 },
    "master": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transpose": { "type": "integer", "minimum": -24, "maximum": 24 },
        "octaveShift": { "type": "integer", "minimum": -3, "maximum": 3 },
        "tuneHz": { "type": "number", "minimum": 415, "maximum": 466 },
        "mono": { "type": "boolean" }
      }
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/part" }
    },
    "scenes": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/scene" }
    },
    "masterKnob": { "$ref": "#/$defs/masterKnob" },
    "knobs": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/assignable" } },
    "sliders": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/assignable" } },
    "arpeggio": { "$ref": "#/$defs/arpeggio" }
  },
  "$defs": {
    "unit": { "type": "number", "minimum": 0, "maximum": 1 },
    "midiNote": { "type": "integer", "minimum": 0, "maximum": 127 },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["low", "high"],
      "properties": {
        "low": { "$ref": "#/$defs/midiNote" },
        "high": { "$ref": "#/$defs/midiNote" }
      }
    },
    "sends": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reverb": { "$ref": "#/$defs/unit" },
        "delay": { "$ref": "#/$defs/unit" },
        "chorus": { "$ref": "#/$defs/unit" }
      }
    },
    "insert": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["filter", "eq", "compressor", "gate", "drive", "tremolo", "chorus", "phaser", "rotary"] },
        "enabled": { "type": "boolean" },
        "params": { "type": "object", "additionalProperties": { "type": "number" } }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "instrument"],
      "properties": {
        "id": { "type": "integer", "minimum": 1, "maximum": 16 },
        "name": { "type": "string", "minLength": 1, "maxLength": 32 },
        "enabled": { "type": "boolean" },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "instrument": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "ref"],
          "properties": {
            "type": { "enum": ["sfz", "synth"] },
            "ref": { "type": "string", "minLength": 1 }
          }
        },
        "keyRange": { "$ref": "#/$defs/range" },
        "velocityRange": { "$ref": "#/$defs/range" },
        "transpose": { "type": "integer", "minimum": -48, "maximum": 48 },
        "channel": { "type": "integer", "minimum": 0, "maximum": 16, "description": "0 = omni" },
        "velocityCurve": { "enum": ["soft", "normal", "hard"] },
        "volume": { "$ref": "#/$defs/unit" },
        "pan": { "type": "number", "minimum": -1, "maximum": 1 },
        "sends": { "$ref": "#/$defs/sends" },
        "inserts": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/insert" } }
      }
    },
    "sceneState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "volume": { "$ref": "#/$defs/unit" },
        "pan": { "type": "number", "minimum": -1, "maximum": 1 },
        "sends": { "$ref": "#/$defs/sends" },
        "effects": { "type": "object", "additionalProperties": { "type": "number" } }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "parts"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 32 },
        "parts": {
          "type": "object",
          "propertyNames": { "pattern": "^([1-9]|1[0-6])$" },
          "additionalProperties": { "$ref": "#/$defs/sceneState" }
        },
        "arpeggio": { "$ref": "#/$defs/arpeggio" }
      }
    },
    "masterKnob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mappings"],
      "properties": {
        "name": { "type": "string" },
        "controller": { "type": "string", "description": "optional pedal or CC, for example cc4" },
        "mappings": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["param", "min", "max"],
            "properties": {
              "param": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_.]*$" },
              "min": { "type": "number" },
              "max": { "type": "number" },
              "curve": { "enum": ["linear", "exp", "log", "s-curve"] }
            }
          }
        }
      }
    },
    "assignable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["param"],
      "properties": {
        "label": { "type": "string", "maxLength": 16 },
        "param": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_.]*$" },
        "cc": { "$ref": "#/$defs/midiNote" }
      }
    },
    "arpeggio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "pattern": { "enum": ["up", "down", "updown", "random", "asPlayed"] },
        "rate": { "enum": ["1/4", "1/8", "1/8T", "1/16", "1/16T", "1/32"] },
        "octaves": { "type": "integer", "minimum": 1, "maximum": 4 },
        "gate": { "$ref": "#/$defs/unit" },
        "parts": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 16 } }
      }
    }
  }
}
